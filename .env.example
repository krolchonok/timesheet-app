# Скопируйте в .env и задайте свои значения:
# cp .env.example .env

# development | production
TIMESHEET_ENV=production

# Обязательно в production (случайная строка 32+ символа)
SECRET_KEY=change-me-to-a-long-random-string

# 1 — создать demo admin/user при первом запуске (только для теста)
TIMESHEET_SEED_DEMO=0

HOST=0.0.0.0
PORT=8888

# 1 — только если сайт реально отдаётся по HTTPS (reverse-proxy с SSL).
# По HTTP с Secure=1 браузер будет сбрасывать сессию сразу после входа.
SESSION_COOKIE_SECURE=0

# Опционально: пароль admin при первом запуске (если SEED_DEMO=0)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Опционально: уведомления о проблемах в Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
